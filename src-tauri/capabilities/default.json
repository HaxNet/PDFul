{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: native dialogs and file commands",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "allow-initial-file",
    "allow-read-file",
    "allow-save-file",
    "allow-load-sigs",
    "allow-save-sigs",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "allow-is-tiling"
  ]
}