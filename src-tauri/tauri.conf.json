{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFul",
  "version": "1.2.1",
  "identifier": "com.108cap.pdful",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Annotate, comment, sign, scan and OCR PDFs",
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0"] } }
  }
}
